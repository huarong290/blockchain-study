# ==========================================
# 1. 核心安全与敏感信息（Web3 & 通用）
# ==========================================
# 绝不能提交的环境变量、私钥与证书
.env
.env.*
!.env.example
!.env.template
*.env
*.key
*.pem
*.p12
*.pfx
*.crt
secret.json
secrets.json
keystore/

# ==========================================
# 2. 区核链 & 智能合约 (Solidity/EVM/Foundry/Hardhat)
# ==========================================
# 工具链编译产物与缓存
artifacts/
build/
cache/
out/
coverage/
typechain/
typechain-types/
coverage.json

# 部署记录与临时数据
.mumbai/
.sepolia/
deployments/
broadcast/

# Hardhat / Foundry 临时日志
hardhat.log
anvil.log

# ==========================================
# 3. 前端与 Node.js 开发 (Vue / React / Next.js 等)
# ==========================================
# 包管理器依赖目录
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# 前端构建产物
dist/
dist-ssr/
.next/
.nuxt/
.vuepress/dist/
.output/

# 日志与缓存
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
.vite/

# ==========================================
# 4. Java 开发 (Spring Boot / Maven / Gradle)
# ==========================================
# 编译构建产物
target/
.gradle/
build/
bin/
out/

# 打包文件
*.class
*.jar
*.war
*.nar
*.ear

# 运行日志与缓存
*.log
*.crash
hs_err_pid*

# ==========================================
# 5. Python 开发
# ==========================================
# 虚拟环境
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook 缓存
.ipynb_checkpoints

# ==========================================
# 6. IDE、编辑器与系统文件
# ==========================================
# macOS 系统文件
.DS_Store
.AppleDouble
.LSSharedFileList
.Trashes

# Windows 系统文件
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# VS Code 配置（忽略个人配置，保留工程共享配置）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA (Java / Go / WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# Docker 临时状态
.docker/
